generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  passwordHash    String
  name            String
  phone           String?
  avatar          String?
  role            UserRole          @default(CONSUMER)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  settings        Json?
  cartItems       CartItem[]
  addresses       ConsumerAddress[]
  disputes        Dispute[]
  approvedFarmers Farmer[]          @relation("AdminApprovedFarmers")
  farmer          Farmer?           @relation("FarmerProfile")
  notifications   Notification[]
  orders          Order[]
  reviews         Review[]

  @@index([email])
  @@index([role])
}

model Farmer {
  id                    String             @id @default(cuid())
  userId                String             @unique
  farmName              String
  farmLocation          String
  location              String
  city                  String             @default("Bengaluru")
  state                 String             @default("Karnataka")
  pincode               String
  hub                   String
  distanceKm            Decimal?           @default(2.5) @db.Decimal(5, 2)
  farmingMethod         FarmingMethod      @default(ORGANIC)
  yearsFarming          Int                @default(1)
  acreage               Decimal            @default(5.0) @db.Decimal(6, 2)
  mainCrops             String[]
  farmDescription       String?
  story                 String?
  soilPractices         String[]
  waterSource           String?
  certifications        String[]
  coverImage            String?
  gallery               String[]
  rating                Decimal            @default(5.0) @db.Decimal(3, 2)
  reviewCount           Int                @default(0)
  totalProductsCount    Int                @default(0)
  farmSinceYear         Int?
  isVerified            Boolean            @default(false)
  verificationStatus    VerificationStatus @default(PENDING)
  rejectionReason       String?
  registeredAt          DateTime           @default(now())
  approvedAt            DateTime?
  approvedById          String?
  verifiedDate          DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  approvedBy            User?              @relation("AdminApprovedFarmers", fields: [approvedById], references: [id])
  user                  User               @relation("FarmerProfile", fields: [userId], references: [id], onDelete: Cascade)
  verificationDocuments FarmerDocument[]
  harvestBatches        HarvestBatch[]
  inventoryItems        InventoryItem[]
  orderItems            OrderItem[]
  products              Product[]
  reviews               Review[]
  sales                 Sale[]
  surplusOffers         SurplusOffer[]

  @@index([verificationStatus])
  @@index([hub])
  @@index([city])
  @@index([approvedById])
}

model FarmerDocument {
  id         String       @id @default(cuid())
  farmerId   String
  type       DocumentType
  title      String
  fileUrl    String
  fileName   String
  fileSize   Int?
  mimeType   String?
  isVerified Boolean      @default(false)
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  farmer     Farmer       @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([farmerId])
  @@index([type])
}

model Product {
  id                        String          @id @default(cuid())
  farmerId                  String
  name                      String
  category                  ProductCategory @default(VEGETABLES)
  description               String
  price                     Decimal         @db.Decimal(10, 2)
  unit                      String
  unitShort                 String
  images                    String[]
  shelfLifeDays             Int             @default(6)
  expectedFreshnessDuration String?
  harvestDate               DateTime?
  farmDistanceKm            Decimal?        @default(2.5) @db.Decimal(5, 2)
  isOrganic                 Boolean         @default(true)
  farmingMethod             FarmingMethod   @default(ORGANIC)
  status                    ProductStatus   @default(ACTIVE)
  inStock                   Boolean         @default(true)
  availableQuantity         Decimal         @default(0) @db.Decimal(10, 2)
  reservedQuantity          Decimal         @default(0) @db.Decimal(10, 2)
  soldQuantity              Decimal         @default(0) @db.Decimal(10, 2)
  lowStockThreshold         Decimal         @default(10) @db.Decimal(10, 2)
  rating                    Decimal         @default(5.0) @db.Decimal(3, 2)
  reviewsCount              Int             @default(0)
  nutritionHighlights       String[]
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  cartItems                 CartItem[]
  harvestBatches            HarvestBatch[]
  inventory                 InventoryItem?
  orderItems                OrderItem[]
  farmer                    Farmer          @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  reviews                   Review[]
  surplusOffers             SurplusOffer[]

  @@index([farmerId])
  @@index([category])
  @@index([status])
  @@index([inStock])
}

model InventoryItem {
  id                String          @id @default(cuid())
  productId         String          @unique
  farmerId          String
  currentStock      Decimal         @default(0) @db.Decimal(10, 2)
  availableQuantity Decimal         @default(0) @db.Decimal(10, 2)
  reservedQuantity  Decimal         @default(0) @db.Decimal(10, 2)
  soldQuantity      Decimal         @default(0) @db.Decimal(10, 2)
  threshold         Decimal         @default(15) @db.Decimal(10, 2)
  status            InventoryStatus @default(IN_STOCK)
  lastUpdated       DateTime        @default(now()) @updatedAt
  createdAt         DateTime        @default(now())
  farmer            Farmer          @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  logs              InventoryLog[]

  @@index([farmerId])
  @@index([status])
}

model InventoryLog {
  id              String           @id @default(cuid())
  inventoryItemId String
  type            InventoryLogType
  amount          Decimal          @db.Decimal(10, 2)
  newQuantity     Decimal          @db.Decimal(10, 2)
  reason          String
  createdAt       DateTime         @default(now())
  inventoryItem   InventoryItem    @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([createdAt])
}

model HarvestBatch {
  id                    String              @id @default(cuid())
  batchNumber           String              @unique
  farmerId              String
  productId             String
  harvestDate           DateTime
  quantity              Decimal             @db.Decimal(10, 2)
  availableQuantity     Decimal             @db.Decimal(10, 2)
  unit                  String
  farmingMethod         FarmingMethod       @default(ORGANIC)
  location              String?
  expectedShelfLifeDays Int                 @default(6)
  expectedFreshness     Int                 @default(95)
  status                HarvestStatus       @default(AVAILABLE)
  qrCodeUrl             String?
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  farmer                Farmer              @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  product               Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  surplusOffers         SurplusOffer[]
  traceabilityEvents    TraceabilityEvent[]

  @@index([farmerId])
  @@index([productId])
  @@index([batchNumber])
  @@index([harvestDate])
}

model TraceabilityEvent {
  id         String           @id @default(cuid())
  batchId    String
  step       TraceabilityStep
  title      String
  location   String
  timestamp  DateTime
  details    String
  completed  Boolean          @default(true)
  verifiedBy String?
  actor      String?
  orderIndex Int              @default(0)
  createdAt  DateTime         @default(now())
  batch      HarvestBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([orderIndex])
}

model SurplusOffer {
  id                String             @id @default(cuid())
  offerCode         String             @unique
  farmerId          String
  productId         String
  batchId           String?
  availableQuantity Decimal            @db.Decimal(10, 2)
  unit              String
  originalPrice     Decimal            @db.Decimal(10, 2)
  discountPercent   Int
  offerPrice        Decimal            @db.Decimal(10, 2)
  expiryDate        DateTime
  reason            String
  status            SurplusOfferStatus @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  cartItems         CartItem[]
  orderItems        OrderItem[]
  batch             HarvestBatch?      @relation(fields: [batchId], references: [id])
  farmer            Farmer             @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([farmerId])
  @@index([productId])
  @@index([status])
  @@index([expiryDate])
}

model ConsumerAddress {
  id          String   @id @default(cuid())
  userId      String
  name        String
  phone       String
  addressLine String
  city        String   @default("Bengaluru")
  state       String   @default("Karnataka")
  pincode     String
  hub         String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@index([userId])
  @@index([hub])
}

model Order {
  id                String              @id @default(cuid())
  orderNumber       String              @unique
  consumerId        String
  addressId         String?
  deliverySlotName  String
  deliverySlotRange String
  status            OrderStatus         @default(PLACED)
  subtotal          Decimal             @db.Decimal(10, 2)
  deliveryFee       Decimal             @default(0) @db.Decimal(10, 2)
  platformFee       Decimal             @default(0) @db.Decimal(10, 2)
  farmerEarnings    Decimal             @default(0) @db.Decimal(10, 2)
  total             Decimal             @db.Decimal(10, 2)
  paymentMethod     PaymentMethod       @default(UPI)
  paymentStatus     PaymentStatus       @default(PENDING)
  deliveryBatchId   String?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  disputes          Dispute[]
  address           ConsumerAddress?    @relation(fields: [addressId], references: [id])
  consumer          User                @relation(fields: [consumerId], references: [id])
  deliveryBatch     DeliveryBatch?      @relation(fields: [deliveryBatchId], references: [id])
  items             OrderItem[]
  timeline          OrderTimelineStep[]
  sales             Sale[]

  @@index([consumerId])
  @@index([status])
  @@index([deliveryBatchId])
  @@index([createdAt])
}

model OrderItem {
  id             String        @id @default(cuid())
  orderId        String
  productId      String?
  farmerId       String
  productName    String
  productImage   String
  farmerName     String
  farmName       String
  unitPrice      Decimal       @db.Decimal(10, 2)
  quantity       Decimal       @db.Decimal(10, 2)
  unit           String
  totalPrice     Decimal       @db.Decimal(10, 2)
  createdAt      DateTime      @default(now())
  surplusOfferId String?
  farmer         Farmer        @relation(fields: [farmerId], references: [id])
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product?      @relation(fields: [productId], references: [id])
  surplusOffer   SurplusOffer? @relation(fields: [surplusOfferId], references: [id])
  sales          Sale[]

  @@index([orderId])
  @@index([farmerId])
  @@index([productId])
  @@index([surplusOfferId])
}

model OrderTimelineStep {
  id          String      @id @default(cuid())
  orderId     String
  status      OrderStatus
  label       String
  description String
  isCompleted Boolean     @default(false)
  isCurrent   Boolean     @default(false)
  timestamp   DateTime    @default(now())
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model DeliveryBatch {
  id                    String                      @id @default(cuid())
  batchCode             String                      @unique
  hubArea               String
  deliverySlot          String
  status                DeliveryBatchStatus         @default(PENDING)
  riderName             String?
  riderPhone            String?
  riderVehicle          String?
  estimatedDistanceKm   Decimal?                    @db.Decimal(6, 2)
  estimatedDeliveryTime String?
  totalQuantity         Decimal?                    @db.Decimal(10, 2)
  productsSummary       String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  timelineSteps         DeliveryBatchTimelineStep[]
  orders                Order[]

  @@index([hubArea])
  @@index([status])
}

model DeliveryBatchTimelineStep {
  id          String              @id @default(cuid())
  batchId     String
  status      DeliveryBatchStatus
  label       String
  timestamp   DateTime            @default(now())
  isCompleted Boolean             @default(false)
  isCurrent   Boolean             @default(false)
  batch       DeliveryBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
}

model Sale {
  id                   String     @id @default(cuid())
  saleCode             String     @unique
  orderId              String
  farmerId             String
  orderItemId          String?
  productName          String
  category             String
  quantity             Decimal    @db.Decimal(10, 2)
  unit                 String
  revenue              Decimal    @db.Decimal(10, 2)
  status               SaleStatus @default(PENDING_PAYOUT)
  payoutDate           DateTime?
  transactionReference String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  farmer               Farmer     @relation(fields: [farmerId], references: [id])
  order                Order      @relation(fields: [orderId], references: [id])
  orderItem            OrderItem? @relation(fields: [orderItemId], references: [id])

  @@index([farmerId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(ORDER)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model Review {
  id               String   @id @default(cuid())
  userId           String
  farmerId         String
  productId        String?
  rating           Int      @default(5)
  comment          String
  verifiedPurchase Boolean  @default(true)
  createdAt        DateTime @default(now())
  farmer           Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  product          Product? @relation(fields: [productId], references: [id])
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([farmerId])
  @@index([productId])
  @@index([userId])
}

model Dispute {
  id          String        @id @default(cuid())
  orderId     String
  userId      String
  productName String
  reason      String
  amount      Decimal       @db.Decimal(10, 2)
  status      DisputeStatus @default(OPEN)
  description String
  resolution  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  order       Order         @relation(fields: [orderId], references: [id])
  user        User          @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([userId])
  @@index([status])
}

model CartItem {
  id             String        @id @default(cuid())
  userId         String
  productId      String
  quantity       Decimal       @default(1) @db.Decimal(10, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  lineKey        String
  surplusOfferId String?
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  surplusOffer   SurplusOffer? @relation(fields: [surplusOfferId], references: [id])
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lineKey])
  @@index([userId])
  @@index([productId])
  @@index([surplusOfferId])
}

enum UserRole {
  ADMIN
  FARMER
  CONSUMER
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FarmingMethod {
  ORGANIC
  NATURAL_ZBNF
  HYDROPONIC
  REGENERATIVE
  PESTICIDE_FREE
  TRADITIONAL
  CONVENTIONAL
  MIXED
}

enum ProductStatus {
  ACTIVE
  DRAFT
  OUT_OF_STOCK
  EXPIRED
}

enum ProductCategory {
  VEGETABLES
  FRUITS
  DAIRY
  GRAINS
  PULSES
  EGGS
  HERBS
  SPICES
  ORGANIC_SPECIALTY
  OTHER
}

enum HarvestStatus {
  AVAILABLE
  LOW_STOCK
  SOLD_OUT
  SURPLUS
  EXPIRED
  DEPLETED
}

enum TraceabilityStep {
  FARM_ORIGIN
  HARVEST
  PACK
  DISPATCH
  DELIVERY
}

enum SurplusOfferStatus {
  ACTIVE
  CLAIMED
  EXPIRED
  CANCELLED
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  EXPIRED
}

enum InventoryLogType {
  ADD
  REMOVE
  ADJUSTMENT
  ORDER_RESERVED
  ORDER_FULFILLED
  HARVEST_INCOMING
  SPOILAGE_DISCARD
}

enum OrderStatus {
  PLACED
  CONFIRMED
  HARVESTING
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  UPI
  CARD
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum DeliveryBatchStatus {
  PENDING
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum SaleStatus {
  COMPLETED
  PENDING_PAYOUT
  PAID_OUT
  REFUNDED
}

enum NotificationType {
  ORDER
  INVENTORY
  REVIEW
  SYSTEM
  VERIFICATION
  DELIVERY
  DISPUTE
}

enum DocumentType {
  GOVERNMENT_ID
  LAND_OWNERSHIP_RTC
  FARM_PHOTO
  ORGANIC_CERTIFICATE
  WATER_TEST_REPORT
  OTHER
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}
